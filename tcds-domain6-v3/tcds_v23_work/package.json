{
  "name": "tcds-domain6-warehouse-pwa-shell-green-tier1-v3",
  "version": "3.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "tsc --noEmit",
    "verify:registry": "node scripts/verify-public-registry.mjs",
    "verify": "npm run verify:registry && npm run check && npm run build",
    "scandit:sync": "node scripts/scandit/sync-scandit-runtime.mjs",
    "scandit:version": "node scripts/scandit/generate-scandit-version.mjs",
    "scandit:manifest": "node scripts/scandit/generate-scandit-manifest.mjs",
    "scandit:verify-version": "node scripts/scandit/verify-scandit-version.mjs",
    "scandit:verify-runtime": "node scripts/scandit/verify-scandit-runtime.mjs",
    "scandit:architecture": "node scripts/scandit/verify-scandit-boundary.mjs",
    "scandit:preflight": "npm run scandit:verify-version && npm run scandit:verify-runtime && npm run scandit:architecture",
    "scandit:prepare": "npm run scandit:sync && npm run scandit:version && npm run scandit:manifest",
    "scandit:lint-boundary": "eslint -c config/eslint/scandit-boundary.config.mjs \"src/**/*.{ts,tsx}\"",
    "scandit:test": "vitest run --config config/vitest/scandit.vitest.config.ts",
    "scandit:verify-pwa-cache": "node scripts/scandit/verify-scandit-pwa-cache.mjs",
    "scandit:verify-dist": "node scripts/scandit/verify-scandit-dist.mjs",
    "scandit:certify": "npm run scandit:preflight && npm run scandit:lint-boundary && npm run scandit:test && npm run build && npm run scandit:verify-dist && npm run scandit:verify-pwa-cache",
    "prebuild": "npm run scandit:prepare && npm run scandit:preflight",
    "scandit:capture:architecture": "node scripts/scandit/verify-domain6-2b-boundary.mjs",
    "scandit:capture:test": "vitest run --config config/vitest/scandit-6.2b.vitest.config.ts",
    "scandit:capture:certify": "npm run scandit:certify && npm run scandit:capture:verify-sdk && npm run scandit:capture:verify-legacy && npm run scandit:capture:architecture && npm run scandit:capture:typecheck && npm run scandit:capture:test && npm run build",
    "scandit:capture:verify-sdk": "node scripts/scandit/verify-domain6-2b-sdk-version.mjs",
    "scandit:capture:verify-legacy": "node scripts/scandit/verify-legacy-scandit-adapter-absent.mjs",
    "scandit:capture:typecheck": "tsc --noEmit -p config/typescript/scandit-6.2b.tsconfig.json",
    "scandit:capture:migrate-retire-legacy": "node scripts/scandit/retire-legacy-scandit-adapter.mjs"
  },
  "dependencies": {
    "@scandit/web-datacapture-barcode": "8.5.3",
    "@scandit/web-datacapture-core": "8.5.3",
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/parser": "8.67.0",
    "autoprefixer": "10.4.20",
    "eslint": "10.8.1",
    "jsdom": "26.1.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
