DOMAIN10_PLANNER_ENABLED=false
DOMAIN10_ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/tcds

DOMAIN10_EVENT_MAX_PAYLOAD_BYTES=262144
DOMAIN10_EVENT_MAX_CLOCK_SKEW_SECONDS=300
DOMAIN10_PLANNER_BATCH_SIZE=20
DOMAIN10_PLANNER_LEASE_SECONDS=120
DOMAIN10_PLANNER_MAX_ATTEMPTS=5
DOMAIN10_PLANNER_RETRY_BASE_MS=5000
DOMAIN10_PLANNER_RETRY_MAX_MS=300000
DOMAIN10_PLANNER_POLL_MS=1000

LOG_LEVEL=info
